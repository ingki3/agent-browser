# ---------------------------------------------------------------------------
# agent-browser 로컬 설정 예시
#
# 사용법:
#   cp .env.example .env
#   그 다음 .env를 열어 실제 키를 채워 넣으십시오.
#
# 주의: .env는 .gitignore에 등록되어 있습니다. 절대 커밋하지 마십시오.
#       .env.example에는 실제 키를 넣지 마십시오(이 파일은 추적됩니다).
# ---------------------------------------------------------------------------

# [필수] OpenRouter API 키. https://openrouter.ai/keys 에서 발급합니다.
OPENROUTER_API_KEY=sk-or-v1-여기에_실제_키를_넣으십시오

# [선택] 사용할 모델. 미지정 시 openai/gpt-4o-mini.
#
# 모델 선택 기준:
#   - 관찰 토큰 KPI가 tiktoken cl100k_base 기준이므로, OpenAI 계열이
#     측정값과 과금 토큰이 가장 잘 맞습니다.
#   - 태스크당 상한이 $0.75(contracts.thresholds.MAX_USD_PER_TASK)이므로
#     30스텝을 돌리려면 저비용 모델이 유리합니다.
#
# 검증된 선택지 (100만 토큰당 입력/출력 단가):
#   openai/gpt-4o-mini                  $0.15 / $0.60   (기본값, 권장)
#   google/gemini-2.0-flash-001         $0.10 / $0.40   (최저가)
#   anthropic/claude-3.5-haiku          $0.80 / $4.00
#   openai/gpt-4o                       $2.50 / $10.00  (고성능)
#   anthropic/claude-3.5-sonnet         $3.00 / $15.00  (고성능)
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# 아래는 모두 선택 사항입니다. 기본값으로 충분합니다.
# ---------------------------------------------------------------------------

# API 베이스 URL. 프록시를 경유할 때만 변경하십시오.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter 순위 페이지에 표시될 앱 정보.
# OPENROUTER_APP_URL=https://github.com/your-name/agent-browser
# OPENROUTER_APP_TITLE=agent-browser

# 단일 호출 타임아웃(초)과 재시도 횟수.
# 재시도는 429/5xx에만 적용되며 지수 백오프를 사용합니다.
# OPENROUTER_TIMEOUT_S=60
# OPENROUTER_MAX_RETRIES=2
